# All configuration is OPTIONAL — the app runs with this file absent.
# Copy to `.env.local` and fill in what you need, then restart the dev server / rebuild.

# WalletConnect support (mobile wallets + QR flow). Free project ID from
# https://cloud.walletconnect.com — without it, browser-extension wallets still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
